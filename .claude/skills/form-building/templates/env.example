# Form endpoint for the contact form.
# Override per environment in the deployment platform's project settings.
# The fallback inside ContactForm.tsx targets the live production endpoint, so
# this var is technically optional in prod. Setting it explicitly is cleaner
# and required if you deploy a clone with a different endpoint (staging,
# different client site, etc.).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/REPLACE_WITH_FORM_ID
