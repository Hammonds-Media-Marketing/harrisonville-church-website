# Harrisonville Church of Christ — environment configuration
# Copy to .env.local for local development; set the real values in Vercel project settings.

# Canonical site origin (no trailing slash). Used for metadata, canonical URLs, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://harrisonvillecoc.com

# Formspree endpoint for the contact / prayer / Bible-study forms.
# Endpoint pending ("Coming Soon"). Replace with https://formspree.io/f/<id> when issued.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Analytics (placeholders — fill when accounts are provisioned)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# IndexNow key (public verification token; hosted at /<key>.txt). Rotate via env.
# When issued, also drop a file public/<key>.txt whose contents are the key.
INDEXNOW_KEY=

# Shared secret for the /api/revalidate webhook (CMS publish -> ISR + IndexNow).
REVALIDATE_SECRET=

# Supabase — powers the CMS (blog, events, sermons) and the members backend
# (auth, announcements, member directory, on-site admin at /members/admin).
# Set both in Vercel project settings. Use the project's *publishable* key
# (sb_publishable_...) or legacy anon key — Row Level Security is the whole
# authorization model: the public key reads only published content; signed-in
# members, editors, and admins get their access through their session, and no
# service-role key is used anywhere. If these are unset, public pages fall
# back to the local seed content in content/ and the members area shows its
# setup notice, so the site still renders.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
