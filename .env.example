# Harrisonville Church of Christ — environment configuration
# Copy to .env.local for local development; set the real values in Vercel project settings.

# Canonical site origin (no trailing slash). Used for metadata, canonical URLs, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://harrisonvillecoc.com

# Formspree endpoint for the contact / prayer / Bible-study forms.
# Endpoint pending ("Coming Soon"). Replace with https://formspree.io/f/<id> when issued.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Analytics (placeholders — fill when accounts are provisioned)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# IndexNow key (public verification token; hosted at /<key>.txt). Rotate via env.
INDEXNOW_KEY=

# Supabase (deferred — wire later; the site renders from local seed content until set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
